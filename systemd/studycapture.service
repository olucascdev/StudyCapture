[Unit]
Description=StudyCapture local transcription server
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/studycapture/config.env
WorkingDirectory=%h/Documentos/projects/study-capture
ExecStart=%h/Documentos/projects/study-capture/.venv/bin/python -m uvicorn server.studycapture.main:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
